@using System.Text.Json
@using Microsoft.JSInterop
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="quill-wrapper" style="border: 1px solid #ccc; min-height: 350px;">
    <div @ref="_editorElement" style="height: 300px;" id="@_editorHtmlId"></div>
</div>

@code {
    private ElementReference _editorElement;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<QuillEditor>? _objectReference;
    private string _editorHtmlId = $"quillEditor{Guid.NewGuid()}";

    [Parameter] public object[]? ToolbarOptions { get; set; }
    [Parameter] public List<IQuillToken> CustomTokens { get; set; } = new();
    [Parameter] public HistoryOptions? HistoryOptions { get; set; }
    [Parameter] public string Theme { get; set; } = "snow";
    [Parameter] public string[]? Formats { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = false;
    /*[Parameter] public bool Syntax { get; set; } = false;
    [Parameter] public string? HighlightCss { get; set; } = "https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.12.0/build/styles/default.min.css";
    [Parameter] public string? HighlightJs { get; set; } = "https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.12.0/build/highlight.min.js";*/

    [Parameter] public EventCallback<QuillOnTextChangeEventArgs> OnTextChange { get; set; }
    [Parameter] public EventCallback<QuillOnSelectionChangeEventArgs> OnSelectionChange { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Console.WriteLine("OnAfterRenderAsync called");
        if (firstRender)
        {
            _objectReference = DotNetObjectReference.Create(this);

            Console.WriteLine("Load js-module");
            // Load the isolated JS file next to the razor file
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/YngveHestem.Quill.Blazor/QuillEditor.razor.js");
            Console.WriteLine("Loaded js-module: " + _jsModule);

            // Serialize configurations to JSON cleanly
            var config = new 
            { 
                tokens = CustomTokens, 
                toolbarOptions = ToolbarOptions,
                history = HistoryOptions,
                theme = Theme,
                formats = Formats,
                placeholder = Placeholder,
                readOnly = ReadOnly,
                /*syntax = Syntax,
                highlightCss = HighlightCss,
                highlightJs = HighlightJs*/
            };
            var configJson = JsonSerializer.Serialize(config, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

            await _jsModule.InvokeVoidAsync("initialize", _editorElement, _objectReference, configJson, _editorHtmlId);
        }
    }

    [JSInvokable]
    public async Task OnToolbarTokenClicked(string tokenId)
    {
        var token = CustomTokens.FirstOrDefault(t => t.Id == tokenId);
        if (token == null)
        {
            return;
        }
        var res = await token.OnToolbarButtonClicked();
        if (res != null)
        {
            await InsertToken(tokenId, res.Value, res.VisibleToken);
        }
    }

    [JSInvokable]
    public async Task OnTokenClicked(int index, string id, string value)
    {
        var token = CustomTokens.FirstOrDefault(t => t.Id == id);
        if (token == null)
        {
            return;
        }
        var res = await token.OnTokenClicked(value);
        if (res != null)
        {
            await UpdateToken(index, id, res.Value, res.VisibleToken);
        }
    }

    [JSInvokable]
    public async Task CallOnTextChange(QuillDelta delta, QuillDelta oldDelta, string source)
    {
        QuillSource sourceAsEnum;
        switch(source)
        {
            case "user":
                sourceAsEnum = QuillSource.User;
                break;
            case "api":
                sourceAsEnum = QuillSource.Api;
                break;
            case "silent":
                sourceAsEnum = QuillSource.Silent;
                break;
            default:
                sourceAsEnum = QuillSource.Api;
                break;
        }
        await OnTextChange.InvokeAsync(new QuillOnTextChangeEventArgs(delta, oldDelta, sourceAsEnum));
    }

    [JSInvokable]
    public async Task CallOnSelectionChange(QuillRange range, QuillRange oldRange, string source)
    {
        QuillSource sourceAsEnum;
        switch(source)
        {
            case "user":
                sourceAsEnum = QuillSource.User;
                break;
            case "api":
                sourceAsEnum = QuillSource.Api;
                break;
            case "silent":
                sourceAsEnum = QuillSource.Silent;
                break;
            default:
                sourceAsEnum = QuillSource.Api;
                break;
        }
        await OnSelectionChange.InvokeAsync(new QuillOnSelectionChangeEventArgs(range, oldRange, sourceAsEnum));
    }

    // Public API Methods exposed to parent pages
    public async Task InsertToken(string tokenId, string value, HtmlElement visibleToken)
    {
        if (_jsModule != null)
            await _jsModule.InvokeVoidAsync("insertToken", _editorElement, tokenId, value, visibleToken);
    }

    public async Task UpdateToken(int index, string tokenId, string value, HtmlElement visibleToken)
    {

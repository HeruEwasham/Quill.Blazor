        return await _jsModule.InvokeAsync<int>("getCursorIndex", _editorElement);
    }

    public async ValueTask DisposeAsync()
    {
        _objectReference?.Dispose();
        if (_jsModule != null)
        {
            await _jsModule.DisposeAsync();
        }
    }

